+    // Builds a local data-URL preview from the just-uploaded texture file so the UI
+    // reflects the new texture immediately, without depending on the upload response
+    // (UploadTextureAsync only returns an error, not the stored path).
+    private static async Task<string> BuildTexturePreviewDataUrlAsync(IBrowserFile file)
+    {
+        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
+        var buffer = new byte[file.Size];
+        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
+        await stream.ReadAsync(buffer);
+        var base64 = Convert.ToBase64String(buffer);
+        var contentType = extension == ".png" ? "image/png" : "image/jpeg";
+        return $"data:{contentType};base64,{base64}";
+    }
