+    for (var col = 0; col < 8; col++) {
+      var pivot = col;
+      for (var r = col + 1; r < 8; r++)
+        if (Math.abs(a[r][col]) > Math.abs(a[pivot][col])) pivot = r;
+      var tmp = a[col]; a[col] = a[pivot]; a[pivot] = tmp;
+      var tb = b[col]; b[col] = b[pivot]; b[pivot] = tb;
