+    public async Task<string?> UploadTextureAsync(int id, Stream fileStream, string fileName)
+    {
+        using var content = new MultipartFormDataContent();
+        using var streamContent = new StreamContent(fileStream);
+        var extension = Path.GetExtension(fileName)?.ToLowerInvariant();
+        var contentType = extension switch
+        {
+            ".jpg" or ".jpeg" => "image/jpeg",
+            ".png" => "image/png",
+            _ => "application/octet-stream"
+        };
+        streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);
+        content.Add(streamContent, "texture", fileName);
+
+        var response = await _httpClient.PostAsync($"api/products/{id}/texture", content);
+
+        if (!response.IsSuccessStatusCode)
+        {
+            return await ExtractErrorAsync(response);
+        }
+
+        return null;
+    }
+
     public async Task<List<ProductListDto>> GetLowStockAsync(decimal threshold = 10)
     {
         var result = await _httpClient.GetFromJsonAsync<List<ProductListDto>>($"api/products/low-stock?threshold={threshold}");
         if (result != null)
         {
             foreach (var item in result)
                 item.ImagePath = ResolveImageUrl(item.ImagePath);
         }
         return result ?? new List<ProductListDto>();
     }
