@using NaturalStoneImpex.Api.Models.DTOs
@inject NavigationManager Navigation

@* An index of stone types: thumbnail, name, product count. One column by default; a parent may lay it out
   in columns (see .cat-index-cols in storefront.css). "Всички" comes first, with a 2×2 mosaic of the first
   category photos, which are the same files as the thumbnails below it. *@

<ul class="cat-index">
    <li class="cat-index__item cat-index__item--all">
        <a class="cat-index__link @(_allCurrent ? "is-current" : null)" href="/catalog" aria-current="@(_allCurrent ? "page" : null)">
            <span class="cat-index__thumb cat-index__mosaic" aria-hidden="true">
                @foreach (var src in _mosaic)
                {
                    <img src="@src" alt="" width="26" height="26" loading="lazy" decoding="async" />
                }
            </span>
            <span class="cat-index__name">Всички</span>
            @Count(_total)
        </a>
    </li>
    @foreach (var category in Categories)
    {
        var current = category.Id == SelectedId;
        <li class="cat-index__item">
            <a class="cat-index__link @(current ? "is-current" : null)" href="/catalog?categoryId=@category.Id"
               aria-current="@(current ? "page" : null)">
                @if (Photos.TryGetValue(category.Id, out var photo))
                {
                    <img class="cat-index__thumb" src="@photo" alt="" width="52" height="52" loading="lazy" decoding="async" />
                }
                else
                {
                    <span class="cat-index__thumb cat-index__thumb--empty" aria-hidden="true"></span>
                }
                <span class="cat-index__name">@category.Name</span>
                @Count(category.ProductCount)
            </a>
        </li>
    }
</ul>

@code {
    /// <summary>Categories to list, in display order. The caller decides which ones (e.g. only those with products).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<CategoryDto> Categories { get; set; } = [];

    /// <summary>Category id to representative photo path (IStorefrontQueryService.GetCategoryPhotosAsync).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<int, string> Photos { get; set; } = new Dictionary<int, string>();

    /// <summary>The category being shown in the catalog. With none, "Всички" is current on /catalog only.</summary>
    [Parameter]
    public int? SelectedId { get; set; }

    private int _total;
    private bool _allCurrent;
    private List<string> _mosaic = [];

    protected override void OnParametersSet()
    {
        _total = Categories.Sum(c => c.ProductCount);
        _mosaic = Categories
            .Select(c => Photos.TryGetValue(c.Id, out var p) ? p : null)
            .OfType<string>()
            .Take(4)
            .ToList();

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        _allCurrent = SelectedId is null && string.Equals(path, "catalog", StringComparison.OrdinalIgnoreCase);
    }

    private static RenderFragment Count(int count) =>
        @<span class="cat-index__count"><span class="num" aria-hidden="true">@count</span><span class="visually-hidden">, @NavMatch.ProductCountText(count)</span></span>;
}
