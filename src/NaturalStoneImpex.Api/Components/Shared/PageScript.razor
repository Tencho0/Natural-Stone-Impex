@* Loads a page's JS module on static SSR pages and keeps it alive across enhanced navigation.
   The module may export onLoad(), onUpdate() (after every enhanced load) and onDispose().
   The <page-script> element is defined in js/storefront/shell.js, loaded by App.razor. *@

<page-script src="@Assets[Src]"></page-script>

@code {
    /// <summary>Path under wwwroot, e.g. "js/storefront/calculator.js". Resolved to the fingerprinted URL.</summary>
    [Parameter, EditorRequired]
    public string Src { get; set; } = string.Empty;
}
