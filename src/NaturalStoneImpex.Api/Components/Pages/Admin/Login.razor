@page "/admin/login"
@attribute [ExcludeFromInteractiveRouting]
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using NaturalStoneImpex.Api.Auth
@inject NaturalStoneImpex.Api.Services.IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Вход в администрацията | Natural Stone Impex</PageTitle>

<h1 class="login-panel__title">Вход в администрацията</h1>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <p class="login-panel__error" role="alert">@_errorMessage</p>
}

<EditForm Model="Model" OnValidSubmit="HandleLoginAsync" FormName="login" class="login-panel__form">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="username" class="field-label">Потребителско име</label>
        <InputText id="username" class="field-input" autocomplete="username" @bind-Value="Model.Username" />
        <ValidationMessage For="() => Model.Username" />
    </div>

    <div class="field">
        <label for="password" class="field-label">Парола</label>
        <InputText id="password" type="password" class="field-input" autocomplete="current-password" @bind-Value="Model.Password" />
        <ValidationMessage For="() => Model.Password" />
    </div>

    <button type="submit" class="btn btn-primary login-panel__submit">Вход</button>
</EditForm>

@code {
    private string? _errorMessage;

    [SupplyParameterFromForm(FormName = "login")]
    private LoginForm Model { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized() => Model ??= new();

    private async Task HandleLoginAsync()
    {
        var user = await AuthService.ValidateCredentialsAsync(Model.Username, Model.Password);

        if (user is null)
        {
            _errorMessage = "Грешно потребителско име или парола. Проверете ги и опитайте отново.";
            Model.Password = string.Empty; // never echo the password back into the page
            return;
        }

        var claims = new[]
        {
            new Claim("sub", user.Id.ToString()),
            new Claim("username", user.Username),
        };
        var principal = new ClaimsPrincipal(new ClaimsIdentity(claims, AuthSchemes.Cookie, "username", null));

        await HttpContext.SignInAsync(AuthSchemes.Cookie, principal, new AuthenticationProperties { IsPersistent = true });

        Navigation.NavigateTo(ReturnUrlValidator.ToLocalOrDefault(ReturnUrl), forceLoad: true);
    }

    private sealed class LoginForm
    {
        [Required(ErrorMessage = "Потребителското име е задължително.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Паролата е задължителна.")]
        public string Password { get; set; } = string.Empty;
    }
}
