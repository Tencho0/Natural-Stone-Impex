@page "/admin/invoices/new"
@layout AdminLayout
@attribute [Authorize]
@using NaturalStoneImpex.Client.Formatting
@inject IInvoiceService InvoiceService
@inject IProductService ProductService
@inject NavigationManager Navigation

<PageTitle>Нова доставка · Natural Stone Impex</PageTitle>

<p class="page-back">
    <a href="/admin/invoices"><i class="bi bi-arrow-left" aria-hidden="true"></i> Доставки</a>
</p>

<h1>Нова доставка</h1>

@if (_isLoadingProducts)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="form-grid skeleton" aria-hidden="true">
        @for (var i = 0; i < 3; i++)
        {
            <div class="field">
                <span class="skeleton-bar skeleton-bar--short"></span>
                <span class="skeleton-bar" style="height: var(--target-min); width: 100%;"></span>
            </div>
        }
    </div>
}
else if (_loadError)
{
    <div role="alert">
        <p class="note note--error">Не успяхме да заредим продуктите. Опитайте отново.</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadProductsAsync">Опитай отново</button>
    </div>
}
else
{
    <form class="invoice-form" @onsubmit="HandleSave" @onsubmit:preventDefault novalidate>
        <section class="form-grid" aria-labelledby="sec-info">
            <div class="form-section">
                <h2 class="section-h" id="sec-info">Данни за доставката</h2>

                <div class="field">
                    <label class="field-label" for="supplierName">Доставчик</label>
                    <input id="supplierName" type="text" class="field-input" autocomplete="off"
                           aria-invalid="@Invalid("SupplierName")" aria-describedby="@ErrId("SupplierName")"
                           @bind="SupplierName" @bind:event="oninput" disabled="@Locked" />
                    <div class="field-slot">@FieldError("SupplierName")</div>
                </div>

                <div class="field">
                    <label class="field-label" for="invoiceNumber">Номер на фактура</label>
                    <input id="invoiceNumber" type="text" class="field-input" autocomplete="off"
                           aria-invalid="@Invalid("InvoiceNumber")" aria-describedby="@ErrId("InvoiceNumber")"
                           @bind="InvoiceNumber" @bind:event="oninput" disabled="@Locked" />
                    <div class="field-slot">@FieldError("InvoiceNumber")</div>
                </div>

                <div class="field">
                    <label class="field-label" for="invoiceDate">Дата на фактура</label>
                    <input id="invoiceDate" type="date" class="field-input"
                           aria-invalid="@Invalid("InvoiceDate")" aria-describedby="@ErrId("InvoiceDate")"
                           @bind="InvoiceDate" disabled="@Locked" />
                    <div class="field-slot">@FieldError("InvoiceDate")</div>
                </div>
            </div>
        </section>

        <section class="form-section line-section" aria-labelledby="sec-items">
            <h2 class="section-h" id="sec-items">Артикули</h2>

            @if (_validationErrors.ContainsKey("Items"))
            {
                <p class="field-error" role="alert">@_validationErrors["Items"]</p>
            }

            <div class="line-editor">
                <div class="line-head" aria-hidden="true">
                    <span>Продукт</span>
                    <span>Количество</span>
                    <span>Покупна цена, €</span>
                    <span class="num">Общо</span>
                    <span></span>
                </div>

                @for (var i = 0; i < _items.Count; i++)
                {
                    var index = i;
                    var item = _items[index];
                    var unit = UnitFor(item);
                    <div class="line" role="group" aria-label="@($"Артикул {index + 1}")">
                        <div class="field line__product">
                            <label class="field-label" for="@($"line{index}-product")">Продукт</label>
                            <select id="@($"line{index}-product")" class="field-input"
                                    aria-invalid="@Invalid($"Item{index}_ProductId")" aria-describedby="@ErrId($"Item{index}_ProductId")"
                                    value="@item.ProductId"
                                    @onchange="(e) => OnProductChanged(index, e)"
                                    disabled="@Locked">
                                <option value="">Изберете продукт</option>
                                @foreach (var product in _products)
                                {
                                    <option value="@product.Id">@product.Name (@product.CategoryName), @product.UnitDisplay</option>
                                }
                            </select>
                            <div class="field-slot">@FieldError($"Item{index}_ProductId")</div>
                        </div>

                        <div class="field line__qty">
                            <label class="field-label" for="@($"line{index}-qty")">Количество@(unit is null ? null : $", {unit}")</label>
                            <input id="@($"line{index}-qty")" type="number" class="field-input" inputmode="decimal"
                                   aria-invalid="@Invalid($"Item{index}_Quantity")" aria-describedby="@ErrId($"Item{index}_Quantity")"
                                   value="@item.Quantity"
                                   @onchange="(e) => OnQuantityChanged(index, e)"
                                   min="0.01" step="0.01" disabled="@Locked" />
                            <div class="field-slot">@FieldError($"Item{index}_Quantity")</div>
                        </div>

                        <div class="field line__price">
                            <label class="field-label" for="@($"line{index}-price")">Покупна цена, €</label>
                            <input id="@($"line{index}-price")" type="number" class="field-input" inputmode="decimal"
                                   aria-invalid="@Invalid($"Item{index}_PurchasePrice")" aria-describedby="@ErrId($"Item{index}_PurchasePrice")"
                                   value="@item.PurchasePrice"
                                   @onchange="(e) => OnPurchasePriceChanged(index, e)"
                                   min="0" step="0.01" disabled="@Locked" />
                            <div class="field-slot">@FieldError($"Item{index}_PurchasePrice")</div>
                        </div>

                        <p class="line__total">
                            <span class="line__total-label">Общо</span>
                            <span class="num">@PriceFormat.Money(item.RowTotal)</span>
                        </p>

                        <div class="line__remove">
                            <button type="button" class="btn btn-outline btn-sm"
                                    aria-label="@($"Премахни артикул {index + 1}")"
                                    @onclick="() => RemoveItem(index)"
                                    disabled="@(_items.Count <= 1 || Locked)">
                                Премахни
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div>
                <button type="button" class="btn btn-outline" @onclick="AddItem" disabled="@Locked">Добави артикул</button>
            </div>

            <dl class="totals">
                <dt class="totals__grand">Обща стойност</dt>
                <dd class="totals__grand">@PriceFormat.Money(InvoiceTotal)</dd>
            </dl>
        </section>

        <div class="save-bar">
            @if (_errorMessage is not null)
            {
                <p class="save-bar__error" role="alert">@_errorMessage</p>
            }
            @if (_validationErrors.Count > 0)
            {
                <p class="save-bar__error" role="alert">Поправете отбелязаните полета.</p>
            }
            @if (_showConfirm)
            {
                <div class="inline-confirm" role="group" aria-labelledby="confirm-q" aria-describedby="confirm-w" @onkeydown="OnConfirmKeyDown">
                    <div class="inline-confirm__warnings" id="confirm-w">
                        <p class="inline-confirm__text inline-confirm__text--warn">След запазване наличностите се обновяват автоматично. Доставката не може да се редактира.</p>
                    </div>
                    <p class="inline-confirm__text" id="confirm-q">Запиши доставката?</p>
                    <span class="inline-confirm__actions">
                        <button type="button" class="btn btn-primary btn-sm" @onclick="ConfirmSave" aria-disabled="@(_isSaving ? "true" : null)">
                            @if (_isSaving)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            }
                            Да
                        </button>
                        <button type="button" class="btn btn-outline btn-sm" @ref="_noButton" @onclick="CancelConfirm" aria-disabled="@(_isSaving ? "true" : null)">Не</button>
                    </span>
                    <span class="visually-hidden" role="status">@(_isSaving ? "Изчакайте." : null)</span>
                </div>
            }
            else
            {
                <div class="save-bar__actions">
                    <button type="submit" class="btn btn-primary" @ref="_saveButton">Запази</button>
                    <button type="button" class="btn btn-outline" @onclick="NavigateBack">Отказ</button>
                </div>
            }
        </div>
    </form>
}

@code {
    private List<ProductListDto> _products = new();
    private List<InvoiceItemFormModel> _items = new();
    private bool _isLoadingProducts = true;
    private bool _loadError;
    private bool _isSaving;
    private bool _showConfirm;
    private bool _focusNo;
    private bool _focusSave;
    private ElementReference _noButton;
    private ElementReference _saveButton;
    private string? _errorMessage;
    private Dictionary<string, string> _validationErrors = new();

    private string _supplierName = string.Empty;
    private string _invoiceNumber = string.Empty;
    private DateTime _invoiceDate = DateTime.Today;

    // Editing a header field clears its error, like the line fields do.
    private string SupplierName { get => _supplierName; set { _supplierName = value; ClearValidationError("SupplierName"); } }
    private string InvoiceNumber { get => _invoiceNumber; set { _invoiceNumber = value; ClearValidationError("InvoiceNumber"); } }
    private DateTime InvoiceDate { get => _invoiceDate; set { _invoiceDate = value; ClearValidationError("InvoiceDate"); } }

    private decimal InvoiceTotal => _items.Sum(i => i.RowTotal);

    // The form is read-only while the confirm is open or the save runs, so what was confirmed is what is sent.
    private bool Locked => _isSaving || _showConfirm;

    protected override async Task OnInitializedAsync()
    {
        _items.Add(new InvoiceItemFormModel());
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoadingProducts = true;
        _loadError = false;

        try
        {
            var result = await ProductService.GetAllAsync(page: 1, pageSize: 1000);
            _products = result.Items.Where(p => p.IsActive).ToList();
        }
        catch
        {
            _loadError = true;
        }
        finally
        {
            _isLoadingProducts = false;
        }
    }

    private string? UnitFor(InvoiceItemFormModel item) =>
        item.ProductId is { } id ? _products.FirstOrDefault(p => p.Id == id)?.UnitDisplay : null;

    private string? Invalid(string key) => _validationErrors.ContainsKey(key) ? "true" : null;

    private string? ErrId(string key) => _validationErrors.ContainsKey(key) ? $"err-{key}" : null;

    private RenderFragment? FieldError(string key) => _validationErrors.TryGetValue(key, out var message)
        ? @<p class="field-error" id="@($"err-{key}")" role="alert">@message</p>
        : null;

    private void OnProductChanged(int index, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var productId))
        {
            _items[index].ProductId = productId;
        }
        else
        {
            _items[index].ProductId = null;
        }
        ClearValidationError($"Item{index}_ProductId");
    }

    private void OnQuantityChanged(int index, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var quantity))
        {
            _items[index].Quantity = quantity;
        }
        else
        {
            _items[index].Quantity = null;
        }
        ClearValidationError($"Item{index}_Quantity");
    }

    private void OnPurchasePriceChanged(int index, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var price))
        {
            _items[index].PurchasePrice = price;
        }
        else
        {
            _items[index].PurchasePrice = null;
        }
        ClearValidationError($"Item{index}_PurchasePrice");
    }

    private void AddItem()
    {
        _items.Add(new InvoiceItemFormModel());
    }

    private void RemoveItem(int index)
    {
        if (_items.Count > 1)
        {
            _items.RemoveAt(index);
            // Item errors are keyed by position, so removing a line would leave them on the wrong one.
            foreach (var key in _validationErrors.Keys.Where(k => k.StartsWith("Item") && k.Contains('_')).ToList())
                _validationErrors.Remove(key);
        }
    }

    private void ClearValidationError(string key)
    {
        _validationErrors.Remove(key);
    }

    private bool Validate()
    {
        _validationErrors.Clear();

        if (string.IsNullOrWhiteSpace(_supplierName) || _supplierName.Trim().Length < 2)
        {
            _validationErrors["SupplierName"] = "Доставчикът е задължителен (минимум 2 символа).";
        }
        else if (_supplierName.Trim().Length > 200)
        {
            _validationErrors["SupplierName"] = "Доставчикът не може да надвишава 200 символа.";
        }

        if (string.IsNullOrWhiteSpace(_invoiceNumber))
        {
            _validationErrors["InvoiceNumber"] = "Номерът на фактурата е задължителен.";
        }
        else if (_invoiceNumber.Trim().Length > 50)
        {
            _validationErrors["InvoiceNumber"] = "Номерът на фактурата не може да надвишава 50 символа.";
        }

        if (_invoiceDate == default)
        {
            _validationErrors["InvoiceDate"] = "Датата на фактурата е задължителна.";
        }
        else if (_invoiceDate > DateTime.Today)
        {
            _validationErrors["InvoiceDate"] = "Датата на фактурата не може да бъде в бъдещето.";
        }

        var hasValidItem = false;
        for (var i = 0; i < _items.Count; i++)
        {
            var item = _items[i];

            if (!item.ProductId.HasValue || item.ProductId.Value <= 0)
            {
                _validationErrors[$"Item{i}_ProductId"] = "Изберете продукт.";
            }
            else
            {
                hasValidItem = true;
            }

            if (!item.Quantity.HasValue || item.Quantity.Value <= 0)
            {
                _validationErrors[$"Item{i}_Quantity"] = "Количеството трябва да е по-голямо от 0.";
            }

            if (!item.PurchasePrice.HasValue || item.PurchasePrice.Value < 0)
            {
                _validationErrors[$"Item{i}_PurchasePrice"] = "Покупната цена трябва да е по-голяма или равна на 0.";
            }
        }

        if (!hasValidItem && !_validationErrors.Keys.Any(k => k.StartsWith("Item")))
        {
            _validationErrors["Items"] = "Добавете поне един артикул с избран продукт.";
        }

        return _validationErrors.Count == 0;
    }

    private void HandleSave()
    {
        if (Locked)
            return;

        _errorMessage = null;

        if (!Validate())
            return;

        _showConfirm = true;
        _focusNo = true;
    }

    private void CancelConfirm()
    {
        if (_isSaving)
            return;

        _showConfirm = false;
        _focusSave = true;
    }

    private void OnConfirmKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            CancelConfirm();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNo && _showConfirm)
        {
            _focusNo = false;
            await _noButton.FocusAsync();
        }
        else if (_focusSave && !_showConfirm)
        {
            _focusSave = false;
            await _saveButton.FocusAsync();
        }
    }

    private async Task ConfirmSave()
    {
        if (_isSaving)
            return;

        _isSaving = true;
        _errorMessage = null;
        var navigated = false;

        try
        {
            var request = new CreateInvoiceRequest
            {
                SupplierName = _supplierName.Trim(),
                InvoiceNumber = _invoiceNumber.Trim(),
                InvoiceDate = _invoiceDate,
                Items = _items.Select(item => new CreateInvoiceItemRequest
                {
                    ProductId = item.ProductId!.Value,
                    Quantity = item.Quantity!.Value,
                    PurchasePrice = item.PurchasePrice!.Value
                }).ToList()
            };

            var (response, error) = await InvoiceService.CreateAsync(request);

            if (error is not null)
            {
                _errorMessage = error;
                _showConfirm = false;
                _focusSave = true;
                return;
            }

            // Stay locked while the page changes: the invoice exists now and must not be sent twice.
            navigated = true;
            Navigation.NavigateTo("/admin/invoices?success=" + Uri.EscapeDataString("Доставката е записана. Наличностите са обновени."));
        }
        catch
        {
            _errorMessage = "Възникна грешка при свързване със сървъра.";
            _showConfirm = false;
            _focusSave = true;
        }
        finally
        {
            if (!navigated)
                _isSaving = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/admin/invoices");
    }

    private class InvoiceItemFormModel
    {
        public int? ProductId { get; set; }
        public decimal? Quantity { get; set; }
        public decimal? PurchasePrice { get; set; }

        public decimal RowTotal => (Quantity ?? 0) * (PurchasePrice ?? 0);
    }
}
