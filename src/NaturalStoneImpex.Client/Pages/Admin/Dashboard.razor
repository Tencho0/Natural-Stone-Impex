@page "/admin"
@layout AdminLayout
@attribute [Authorize]
@using NaturalStoneImpex.Client.Formatting
@using NaturalStoneImpex.Client.Models
@using NaturalStoneImpex.Client.Services
@inject IOrderService OrderService
@inject IProductService ProductService

<PageTitle>Табло · Natural Stone Impex</PageTitle>

<h1>Табло</h1>

@if (_stats is not null)
{
    <p class="dash-summary">@DashboardSummary.Text(_stats.PendingOrders, _stats.ConfirmedOrders, _stats.CompletedOrders, _stats.TotalProducts)</p>
}
else if (_statsError is not null)
{
    <div class="dash-summary" role="alert">
        <p class="dash-error">@_statsError</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadStatsAsync">Опитай отново</button>
    </div>
}
else
{
    <p class="dash-summary skeleton" aria-hidden="true"><span class="skeleton-bar"></span></p>
}

<div class="dash-cols">
    <section aria-labelledby="dash-pending">
        <h2 id="dash-pending" class="dash-h">Чакащи поръчки</h2>
        @if (_pendingLoading)
        {
            <div class="visually-hidden" role="status">Зареждане...</div>
            <div class="table-scroll" aria-hidden="true">
                <table class="data-table">
                    <tbody>
                        @for (var i = 0; i < 3; i++)
                        {
                            <tr class="skeleton-row skeleton">
                                <td><span class="skeleton-bar"></span></td>
                                <td><span class="skeleton-bar"></span></td>
                                <td><span class="skeleton-bar"></span></td>
                                <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                                <td><span class="skeleton-bar skeleton-bar--short"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (_pendingError is not null)
        {
            <div role="alert">
                <p class="dash-error">@_pendingError</p>
                <button type="button" class="btn btn-outline btn-sm" @onclick="LoadPendingAsync">Опитай отново</button>
            </div>
        }
        else if (_pendingOrders.Count == 0)
        {
            <p class="dash-empty">Няма чакащи поръчки.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Номер</th>
                            <th scope="col">Клиент</th>
                            <th scope="col" class="dash-hide-sm">Получена</th>
                            <th scope="col" class="num">Сума</th>
                            <th scope="col" class="dash-hide-sm"><span class="visually-hidden">Действие</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in _pendingOrders)
                        {
                            <tr>
                                <td class="nowrap"><a href="/admin/orders/@order.Id">@order.OrderNumber</a></td>
                                <td>@order.CustomerName</td>
                                <td class="nowrap dash-hide-sm">@FormatReceived(order.CreatedAt)</td>
                                <td class="num">@PriceFormat.Money(order.TotalWithVat)</td>
                                <td class="num dash-hide-sm"><a href="/admin/orders/@order.Id" aria-label="Отвори поръчка @order.OrderNumber">Отвори</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="dash-more"><a href="/admin/orders">@(_pendingTotal > 20 ? $"Всички поръчки ({_pendingTotal})" : "Всички поръчки")</a></p>
        }
    </section>

    <section aria-labelledby="dash-low">
        <h2 id="dash-low" class="dash-h">Ниска наличност</h2>
        @if (_lowLoading)
        {
            <div class="visually-hidden" role="status">Зареждане...</div>
            <div class="table-scroll" aria-hidden="true">
                <table class="data-table">
                    <tbody>
                        @for (var i = 0; i < 3; i++)
                        {
                            <tr class="skeleton-row skeleton">
                                <td><span class="skeleton-bar"></span></td>
                                <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (_lowError is not null)
        {
            <div role="alert">
                <p class="dash-error">@_lowError</p>
                <button type="button" class="btn btn-outline btn-sm" @onclick="LoadLowStockAsync">Опитай отново</button>
            </div>
        }
        else if (_lowStock.Count == 0)
        {
            <p class="dash-empty">Няма продукти с ниска наличност.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Продукт</th>
                            <th scope="col" class="num">Наличност</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in _lowStock.Take(LowStockLimit))
                        {
                            <tr>
                                <td><a href="/admin/products/@product.Id/edit">@product.Name</a></td>
                                <td class="num @(product.StockQuantity < 0 ? "dash-negative" : null)">@PriceFormat.Signed(product.StockQuantity, product.UnitDisplay)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_lowStock.Count > LowStockLimit)
            {
                var more = _lowStock.Count - LowStockLimit;
                <p class="dash-more">и още @more @(more == 1 ? "продукт" : "продукта") · <a href="/admin/products">Всички продукти</a></p>
            }
        }
    </section>
</div>

@code {
    private const int LowStockLimit = 10;
    private OrderStatsDto? _stats;
    private int _pendingTotal;
    private List<OrderListDto> _pendingOrders = new();
    private List<ProductListDto> _lowStock = new();

    private bool _pendingLoading = true;
    private bool _lowLoading = true;

    private string? _statsError;
    private string? _pendingError;
    private string? _lowError;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadStatsAsync(), LoadPendingAsync(), LoadLowStockAsync());
    }

    private async Task LoadStatsAsync()
    {
        _statsError = null;
        try
        {
            _stats = await OrderService.GetStatsAsync();
        }
        catch
        {
            _statsError = "Не успяхме да заредим бройките.";
        }
        StateHasChanged();
    }

    // GetRecentAsync returns the latest orders of every status, so older pending orders could be cut off.
    // The orders list filtered to pending (newest first) shows all of them; cancelled ones are not pending.
    private async Task LoadPendingAsync()
    {
        _pendingLoading = true;
        _pendingError = null;
        try
        {
            var page = await OrderService.GetAllAsync(0, 1, 20);
            _pendingTotal = page.TotalCount;
            // Same rule as the stats count, so the list and the summary agree.
            _pendingOrders = page.Items.Where(o => !o.IsCancelled).ToList();
        }
        catch
        {
            _pendingError = "Не успяхме да заредим чакащите поръчки.";
        }
        _pendingLoading = false;
        StateHasChanged();
    }

    private async Task LoadLowStockAsync()
    {
        _lowLoading = true;
        _lowError = null;
        try
        {
            _lowStock = await ProductService.GetLowStockAsync(10);
        }
        catch
        {
            _lowError = "Не успяхме да заредим наличностите.";
        }
        _lowLoading = false;
        StateHasChanged();
    }

    private static string FormatReceived(DateTime createdAt) =>
        createdAt.ToLocalTime().ToString("dd.MM.yyyy, HH:mm");
}
