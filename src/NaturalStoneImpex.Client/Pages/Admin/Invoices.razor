@page "/admin/invoices"
@layout AdminLayout
@attribute [Authorize]
@using NaturalStoneImpex.Client.Formatting
@inject IInvoiceService InvoiceService

<PageTitle>Доставки · Natural Stone Impex</PageTitle>

<div class="page-head">
    <h1>Доставки</h1>
    <a href="/admin/invoices/new" class="btn btn-primary">Нова доставка</a>
</div>

@if (!_isLoading && _errorMessage is null)
{
    <p class="page-summary">@CountText(_invoices.TotalCount)</p>
}

@if (_successMessage is not null)
{
    <p class="note note--ok" role="status">@_successMessage</p>
}

@if (_isLoading)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="table-scroll" aria-hidden="true">
        <table class="data-table">
            <tbody>
                @for (var i = 0; i < 6; i++)
                {
                    <tr class="skeleton-row skeleton">
                        <td><span class="skeleton-bar"></span></td>
                        <td><span class="skeleton-bar skeleton-bar--short"></span></td>
                        <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_errorMessage is not null)
{
    <div role="alert">
        <p class="note note--error">@_errorMessage</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadDataAsync">Опитай отново</button>
    </div>
}
else if (_invoices.Items.Count == 0)
{
    <p class="note">Все още няма записани доставки.</p>
}
else
{
    <div class="table-scroll">
        <table class="data-table stack-sm">
            <thead>
                <tr>
                    <th scope="col">Фактура</th>
                    <th scope="col">Доставчик</th>
                    <th scope="col" class="hide-sm">Дата на фактура</th>
                    <th scope="col" class="hide-md">Въведена</th>
                    <th scope="col" class="num hide-md">Артикули</th>
                    <th scope="col" class="num">Обща стойност</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in _invoices.Items)
                {
                    <tr @key="invoice.Id">
                        <td class="nowrap"><a href="/admin/invoices/@invoice.Id">@invoice.InvoiceNumber</a></td>
                        <td class="stack-sm__main">
                            @invoice.SupplierName
                            <span class="cell-sub show-sm">@invoice.InvoiceDate.ToString("dd.MM.yyyy") · @invoice.TotalItems арт.</span>
                        </td>
                        <td class="hide-sm nowrap">@invoice.InvoiceDate.ToString("dd.MM.yyyy")</td>
                        <td class="hide-md nowrap">@invoice.EntryDate.ToString("dd.MM.yyyy")</td>
                        <td class="num hide-md">@invoice.TotalItems</td>
                        <td class="num">@PriceFormat.Money(invoice.InvoiceTotal)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="_invoices.Page" TotalPages="_invoices.TotalPages" OnPageChanged="OnPageChanged" />
}

@code {
    [SupplyParameterFromQuery(Name = "success")]
    public string? SuccessParam { get; set; }

    private PaginatedResponse<InvoiceListDto> _invoices = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _successMessage;
    private int _currentPage = 1;
    private const int PageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(SuccessParam))
        {
            _successMessage = SuccessParam;
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _invoices = await InvoiceService.GetAllAsync(_currentPage, PageSize);
        }
        catch
        {
            _errorMessage = "Не успяхме да заредим доставките. Опитайте отново.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadDataAsync();
    }

    private static string CountText(int count) => count == 1 ? "1 доставка" : $"{count} доставки";
}
