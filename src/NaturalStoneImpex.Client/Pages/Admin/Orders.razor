@page "/admin/orders"
@layout AdminLayout
@attribute [Authorize]
@using NaturalStoneImpex.Client.Formatting
@inject IOrderService OrderService

<PageTitle>Поръчки · Natural Stone Impex</PageTitle>

<h1 tabindex="-1" @ref="_heading">Поръчки</h1>

@if (_stats is not null)
{
    <p class="page-summary">@DashboardSummary.Orders(_stats.PendingOrders, _stats.ConfirmedOrders, _stats.CompletedOrders)</p>
}

<div class="segmented" role="group" aria-label="Покажи поръчки">
    @foreach (var (status, label) in Filters)
    {
        <button type="button" class="segmented__btn" aria-pressed="@(_activeFilter == status ? "true" : "false")"
                @onclick="() => OnFilterChangedAsync(status)">@label</button>
    }
</div>

<p class="visually-hidden" role="status">@_announcement</p>

@if (_isLoading)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="table-scroll" aria-hidden="true">
        <table class="data-table">
            <tbody>
                @for (var i = 0; i < 5; i++)
                {
                    <tr class="skeleton-row skeleton">
                        <td><span class="skeleton-bar"></span></td>
                        <td><span class="skeleton-bar"></span></td>
                        <td><span class="skeleton-bar skeleton-bar--short"></span></td>
                        <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_loadError is not null)
{
    <div role="alert">
        <p class="note note--error">@_loadError</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadAsync">Опитай отново</button>
    </div>
}
else if (_orders.Items.Count == 0)
{
    <p class="note">@EmptyText</p>
}
else
{
    <div class="table-scroll">
        @* .has-actions reserves the confirm's width on desktop, so opening one never moves the columns. *@
        <table class="data-table stack-sm @(_orders.Items.Any(o => o.Status == 0 && !o.IsCancelled) ? "has-actions" : null)">
            <thead>
                <tr>
                    <th scope="col">Номер</th>
                    <th scope="col" class="hide-sm">Получена</th>
                    <th scope="col">Клиент</th>
                    <th scope="col" class="hide-md">Получаване</th>
                    <th scope="col" class="hide-sm">Статус</th>
                    <th scope="col" class="num">Сума</th>
                    <th scope="col"><span class="visually-hidden">Действие</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in _orders.Items)
                {
                    var id = order.Id;
                    var statusText = OrderFormat.StatusText(order.Status, order.IsCancelled);
                    var statusCss = OrderFormat.StatusCss(order.Status, order.IsCancelled);
                    <tr @key="id">
                        <td class="nowrap"><a href="/admin/orders/@id" @ref="_links[id]">@order.OrderNumber</a></td>
                        <td class="nowrap hide-sm">@OrderFormat.Timestamp(order.CreatedAt)</td>
                        <td class="stack-sm__main">
                            @order.CustomerName
                            @* On phones the status column makes way, so the status sits under the name. *@
                            <span class="cell-sub show-sm"><span class="@statusCss">@statusText</span></span>
                        </td>
                        <td class="nowrap hide-md">@order.DeliveryMethodDisplay</td>
                        <td class="hide-sm"><span class="@statusCss">@statusText</span></td>
                        <td class="num">@PriceFormat.Money(order.TotalWithVat)</td>
                        <td class="action-cell">
                            @if (order.Status == 0 && !order.IsCancelled)
                            {
                                var orderNumber = order.OrderNumber;
                                <InlineConfirm Label="Потвърди"
                                               TriggerAriaLabel="@($"Потвърди поръчка {orderNumber}")"
                                               TriggerClass="btn-outline btn-sm"
                                               Question="Потвърди поръчката?"
                                               Open="_openId == id"
                                               OpenChanged="open => OnOpenChanged(id, open)"
                                               Prepare="() => OrderConfirmPrompt.BuildAsync(OrderService, id)"
                                               Action="() => OrderService.ConfirmAsync(id)"
                                               FailureText="@OrderConfirmPrompt.FailureText"
                                               Done="() => OnConfirmedAsync(id, orderNumber)" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="_orders.Page" TotalPages="_orders.TotalPages" OnPageChanged="OnPageChangedAsync" />
}

@code {
    private const int PageSize = 20;

    private static readonly (int? Status, string Label)[] Filters =
    [
        (null, "Всички"),
        (0, "Чакащи"),
        (1, "Потвърдени"),
        (2, "Завършени")
    ];

    private PaginatedResponse<OrderListDto> _orders = new();
    private OrderStatsDto? _stats;
    private bool _isLoading = true;
    private string? _loadError;
    private int? _activeFilter;
    private int _currentPage = 1;
    private int? _openId;
    private string? _announcement;
    private int? _focusOrderId;

    private ElementReference _heading;
    private readonly Dictionary<int, ElementReference> _links = new();

    private string EmptyText => _activeFilter switch
    {
        0 => "Няма чакащи поръчки.",
        1 => "Няма потвърдени поръчки.",
        2 => "Няма завършени поръчки.",
        _ => "Все още няма поръчки."
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        await FetchAsync();
        _isLoading = false;
    }

    // Reloads in place, without the skeleton, so focus and the live region survive a confirmation.
    // The open confirm stays open (and busy) until the new rows are in, so a stale "Потвърди" never shows.
    private async Task FetchAsync()
    {
        _loadError = null;
        try
        {
            var statsTask = OrderService.GetStatsAsync();
            var ordersTask = OrderService.GetAllAsync(_activeFilter, _currentPage, PageSize);
            await Task.WhenAll(statsTask, ordersTask);
            _stats = await statsTask;
            _orders = await ordersTask;
            // A row kept by @key keeps its element and its @ref is not captured again, so clearing the map would
            // lose it. Drop only the rows that left; new rows are captured when they render.
            var ids = _orders.Items.Select(o => o.Id).ToHashSet();
            foreach (var stale in _links.Keys.Where(k => !ids.Contains(k)).ToList())
                _links.Remove(stale);
        }
        catch
        {
            _loadError = "Не успяхме да заредим поръчките. Опитайте отново.";
        }
        _openId = null;
    }

    private async Task OnFilterChangedAsync(int? status)
    {
        if (_activeFilter == status)
            return;
        _activeFilter = status;
        _currentPage = 1;
        _announcement = null;
        await LoadAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _currentPage = page;
        _announcement = null;
        await LoadAsync();
    }

    // One open confirm at a time: opening a row closes any other.
    private void OnOpenChanged(int id, bool open)
    {
        if (open)
            _openId = id;
        else if (_openId == id)
            _openId = null;
    }

    private async Task OnConfirmedAsync(int id, string orderNumber)
    {
        await FetchAsync();
        _announcement = $"Поръчка {orderNumber} е потвърдена.";
        _focusOrderId = id;
    }

    // Under "Всички" the confirmed row keeps its place, so focus goes to its number. Under "Чакащи" the row is
    // gone, so focus goes to the heading.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOrderId is not { } id)
            return;
        _focusOrderId = null;
        if (_links.TryGetValue(id, out var link))
            await link.FocusAsync();
        else
            await _heading.FocusAsync();
    }
}
