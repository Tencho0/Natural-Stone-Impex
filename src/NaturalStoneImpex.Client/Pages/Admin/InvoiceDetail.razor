@page "/admin/invoices/{Id:int}"
@layout AdminLayout
@attribute [Authorize]
@using NaturalStoneImpex.Client.Formatting
@inject IInvoiceService InvoiceService

<PageTitle>@(_invoice is not null ? $"Доставка {_invoice.InvoiceNumber}" : "Доставка") · Natural Stone Impex</PageTitle>

<p class="page-back">
    <a href="/admin/invoices"><i class="bi bi-arrow-left" aria-hidden="true"></i> Доставки</a>
</p>

@if (_isLoading)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="skeleton" aria-hidden="true">
        <p class="order-head__skeleton"><span class="skeleton-bar"></span></p>
        <div class="table-scroll">
            <table class="data-table">
                <tbody>
                    @for (var i = 0; i < 3; i++)
                    {
                        <tr class="skeleton-row">
                            <td><span class="skeleton-bar"></span></td>
                            <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                            <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (_notFound)
{
    <h1>Доставката не е намерена</h1>
    <p class="note">Няма доставка с този номер. Може да е въведен грешен адрес.</p>
    <a href="/admin/invoices" class="btn btn-outline">Към доставките</a>
}
else if (_invoice is null)
{
    <h1>Доставка</h1>
    <div role="alert">
        <p class="note note--error">Не успяхме да заредим доставката. Опитайте отново.</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadAsync">Опитай отново</button>
    </div>
}
else
{
    <div class="order-head">
        <h1>Доставка <span class="nowrap">@_invoice.InvoiceNumber</span></h1>
    </div>

    <section class="order-cols" aria-labelledby="inv-h">
        <div>
            <h2 id="inv-h" class="section-h">Данни за доставката</h2>
            <dl class="meta-list">
                <dt>Доставчик</dt>
                <dd>@_invoice.SupplierName</dd>
                <dt>Номер на фактура</dt>
                <dd class="num">@_invoice.InvoiceNumber</dd>
                <dt>Дата на фактура</dt>
                <dd class="num">@_invoice.InvoiceDate.ToString("dd.MM.yyyy")</dd>
                <dt>Дата на въвеждане</dt>
                <dd class="num">@_invoice.EntryDate.ToString("dd.MM.yyyy")</dd>
            </dl>
        </div>
    </section>

    <section aria-labelledby="items-h">
        <h2 id="items-h" class="section-h">Артикули</h2>
        <div class="table-scroll">
            <table class="data-table stack-sm">
                <thead>
                    <tr>
                        <th scope="col">Продукт</th>
                        <th scope="col" class="num hide-sm">Количество</th>
                        <th scope="col" class="num hide-sm">Покупна цена</th>
                        <th scope="col" class="num">Общо</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _invoice.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="num hide-sm">@PriceFormat.Quantity(item.Quantity, item.UnitDisplay)</td>
                            <td class="num hide-sm">@PriceFormat.Money(item.PurchasePrice)</td>
                            <td class="stack-sm__main show-sm cell-sub">
                                @PriceFormat.Quantity(item.Quantity, item.UnitDisplay) × @PriceFormat.Money(item.PurchasePrice)
                            </td>
                            <td class="num">@PriceFormat.Money(item.RowTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <dl class="totals">
            <dt class="totals__grand">Обща стойност</dt>
            <dd class="totals__grand">@PriceFormat.Money(_invoice.InvoiceTotal)</dd>
        </dl>

        <p class="note">Доставките не могат да се редактират. При грешка коригирайте наличностите ръчно от страницата на продукта.</p>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InvoiceDetailDto? _invoice;
    private bool _isLoading = true;
    private bool _notFound;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _notFound = false;
        try
        {
            _invoice = await InvoiceService.GetByIdAsync(Id);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _invoice = null;
            _notFound = true;
        }
        catch
        {
            _invoice = null;
        }
        finally
        {
            _isLoading = false;
        }
    }
}
