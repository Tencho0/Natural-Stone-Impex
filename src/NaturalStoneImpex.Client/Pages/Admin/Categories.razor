@page "/admin/categories"
@layout AdminLayout
@attribute [Authorize]
@inject ICategoryService CategoryService
@inject IJSRuntime JS

<PageTitle>Категории · Natural Stone Impex</PageTitle>

<div class="page-head">
    <h1 tabindex="-1" @ref="_heading">Категории</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenAddModal">Нова категория</button>
</div>

@if (_successMessage is not null)
{
    <p class="note note--ok" role="status">@_successMessage</p>
}

@if (_isLoading)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="table-scroll" aria-hidden="true">
        <table class="data-table">
            <tbody>
                @for (var i = 0; i < 4; i++)
                {
                    <tr class="skeleton-row skeleton">
                        <td><span class="skeleton-bar"></span></td>
                        <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_loadError is not null)
{
    <div role="alert">
        <p class="note note--error">@_loadError</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadCategoriesAsync">Опитай отново</button>
    </div>
}
else if (_categories.Count == 0)
{
    <p class="note">Няма добавени категории.</p>
}
else
{
    <div class="table-scroll">
        <table class="data-table stack-sm actions-row has-actions">
            <thead>
                <tr>
                    <th scope="col">Име</th>
                    <th scope="col" class="num">Продукти</th>
                    <th scope="col"><span class="visually-hidden">Действия</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in _categories)
                {
                    var current = category;
                    <tr @key="current.Id">
                        <td>@current.Name</td>
                        <td class="num">@current.ProductCount</td>
                        <td class="action-cell">
                            <div class="row-actions">
                                <button type="button" class="btn btn-outline btn-sm" @onclick="() => OpenEditModal(current)"
                                        aria-label="@($"Преименувай {current.Name}")">Преименувай</button>
                                <InlineConfirm Label="Изтрий"
                                               TriggerAriaLabel="@($"Изтрий {current.Name}")"
                                               TriggerClass="btn-outline btn-sm"
                                               Question="Изтрий категорията?"
                                               Open="_openId == current.Id"
                                               OpenChanged="open => OnOpenChanged(current.Id, open)"
                                               Action="() => CategoryService.DeleteAsync(current.Id)"
                                               FailureText="Възникна грешка при свързване със сървъра."
                                               Done="() => OnDeletedAsync(current.Name)" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Add and rename modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="categoryModalLabel">@(_editingCategoryId is null ? "Нова категория" : "Преименуване на категория")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Затвори"></button>
            </div>
            <EditForm Model="_formModel" OnValidSubmit="HandleSave" @key="_formKey">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <div class="field">
                        <label class="field-label" for="categoryName">Име</label>
                        <InputText id="categoryName" class="field-input" @bind-Value="_formModel.Name" disabled="@_isSaving" />
                        <div class="field-slot">
                            @if (_modalError is not null)
                            {
                                <p class="field-error" role="alert">@_modalError</p>
                            }
                            else
                            {
                                <p class="field-help">От 2 до 100 символа.</p>
                            }
                            <ValidationMessage For="() => _formModel.Name" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" aria-disabled="@(_isSaving ? "true" : null)">
                        @if (_isSaving)
                        {
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                        }
                        Запази
                    </button>
                    <button type="button" class="btn btn-outline" data-bs-dismiss="modal" disabled="@_isSaving">Отказ</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<CategoryDto> _categories = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _loadError;
    private string? _successMessage;
    private string? _modalError;
    private int? _editingCategoryId;
    private int? _openId;
    private int _formKey;
    private ElementReference _heading;
    private readonly CategoryFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        await FetchAsync();
        _isLoading = false;
    }

    // Reloads in place, without the skeleton, so focus and the success note survive a save or a delete.
    private async Task FetchAsync()
    {
        _loadError = null;

        try
        {
            _categories = await CategoryService.GetAllAsync();
        }
        catch
        {
            _loadError = "Не успяхме да заредим категориите. Опитайте отново.";
        }

        _openId = null;
    }

    private async Task OpenAddModal()
    {
        _editingCategoryId = null;
        _formModel.Name = string.Empty;
        _modalError = null;
        _formKey++;
        await ShowModalAsync("categoryModal");
    }

    private async Task OpenEditModal(CategoryDto category)
    {
        _editingCategoryId = category.Id;
        _formModel.Name = category.Name;
        _modalError = null;
        _formKey++;
        await ShowModalAsync("categoryModal");
    }

    // One open confirm at a time: opening a row closes any other.
    private void OnOpenChanged(int id, bool open)
    {
        if (open)
            _openId = id;
        else if (_openId == id)
            _openId = null;
    }

    private async Task OnDeletedAsync(string name)
    {
        await FetchAsync();
        _successMessage = $"Категорията „{name}“ е изтрита.";
        _ = AutoDismissSuccessAsync();
        await _heading.FocusAsync();
    }

    private async Task HandleSave()
    {
        if (_isSaving)
            return;

        _isSaving = true;
        _modalError = null;

        try
        {
            string? error;

            if (_editingCategoryId is null)
            {
                error = await CategoryService.CreateAsync(_formModel.Name);
            }
            else
            {
                error = await CategoryService.UpdateAsync(_editingCategoryId.Value, _formModel.Name);
            }

            if (error is not null)
            {
                _modalError = error;
            }
            else
            {
                await HideModalAsync("categoryModal");
                _successMessage = _editingCategoryId is null
                    ? "Категорията е добавена."
                    : "Категорията е преименувана.";
                await FetchAsync();
                _ = AutoDismissSuccessAsync();
            }
        }
        catch
        {
            _modalError = "Възникна грешка при свързване със сървъра.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AutoDismissSuccessAsync()
    {
        await Task.Delay(4000);
        _successMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowModalAsync(string modalId)
    {
        await JS.InvokeVoidAsync("showModal", modalId);
    }

    private async Task HideModalAsync(string modalId)
    {
        await JS.InvokeVoidAsync("hideModal", modalId);
    }

    private sealed class CategoryFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Името е задължително.")]
        [System.ComponentModel.DataAnnotations.MinLength(2, ErrorMessage = "Името трябва да е поне 2 символа.")]
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = "Името не може да е повече от 100 символа.")]
        public string Name { get; set; } = string.Empty;
    }
}
