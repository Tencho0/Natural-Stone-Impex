@page "/admin/orders/{Id:int}/receipt"
@layout PrintLayout
@attribute [Authorize]
@using System.Net
@using NaturalStoneImpex.Client.Formatting
@inject IOrderService OrderService
@inject IJSRuntime JS

<PageTitle>@(_order is not null ? $"Разписка {_order.OrderNumber}" : "Разписка") · Natural Stone Impex</PageTitle>

<style>
    @@media screen {
        /* On screen the receipt is a sheet on the admin ground. Buttons and type come from admin.css. */
        .receipt-page {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 32px;
            background: var(--surface);
            border: 1px solid var(--rule);
            border-radius: var(--radius);
            /* The 7-column table is wider than a phone; it scrolls inside the sheet, not the page. */
            overflow-x: auto;
        }
        .no-print {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 32px;
        }
    }

    @@media screen and (max-width: 767.98px) {
        .receipt-page {
            padding: 24px 16px;
        }
    }

    .receipt-page {
        font-family: var(--font-text);
        color: var(--ink);
        font-variant-numeric: tabular-nums;
    }

    .receipt-page .shop-name {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.6em;
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.2;
        text-align: center;
    }

    .receipt-page .shop-line {
        margin: 2px 0;
        font-size: 0.95em;
        text-align: center;
    }

    .receipt-page .receipt-rule {
        margin: 16px 0;
        border: 0;
        border-top: 1px solid var(--rule);
        opacity: 1;
    }

    .receipt-page .doc-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: 1.3em;
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1.2;
        text-align: center;
    }

    .receipt-page .doc-line {
        margin: 2px 0;
        text-align: center;
    }

    .receipt-page .customer {
        margin: 24px 0;
    }

    .receipt-page .customer p {
        margin: 0 0 2px;
    }

    .receipt-page .customer-label {
        font-weight: 600;
    }

    .receipt-page .items-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9em;
    }

    .receipt-page .items-table th,
    .receipt-page .items-table td {
        padding: 5px 8px;
        border: 1px solid var(--rule);
    }

    .receipt-page .items-table th {
        font-weight: 600;
        text-align: center;
        vertical-align: bottom;
    }

    .receipt-page .items-table .num-col {
        text-align: right;
        white-space: nowrap;
    }

    .receipt-page .totals-section {
        margin-top: 16px;
        font-size: 0.95em;
        text-align: right;
    }

    .receipt-page .totals-section p {
        margin: 0 0 4px;
    }

    .receipt-page .totals-section .grand-total {
        font-size: 1.1em;
        font-weight: 600;
    }

    .receipt-page .signatures {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 16px;
        margin-top: 72px;
        font-size: 0.95em;
    }

    .receipt-page .receipt-footer {
        margin-top: 32px;
        font-size: 0.85em;
        text-align: center;
    }

    .receipt-page .receipt-state h1 {
        margin: 0 0 8px;
        font-family: var(--font-display);
        font-size: var(--text-22);
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1.25;
    }

    .receipt-page .receipt-state p {
        margin: 0;
        color: var(--stone);
    }

    /* Print rules come last so they outrank the screen-agnostic receipt rules above. */
    @@media print {
        .no-print {
            display: none !important;
        }

        .sidebar, .navbar, nav, header, footer {
            display: none !important;
        }

        @@page {
            size: A4 portrait;
            margin: 15mm;
        }

        body, html {
            margin: 0;
            padding: 0;
            font-size: 12pt;
        }

        * {
            background: white !important;
            color: black !important;
        }

        .receipt-page {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #fff;
        }

        .receipt-page .items-table th,
        .receipt-page .items-table td {
            border-color: #000;
        }

        .receipt-page .receipt-rule {
            border-top-color: #000;
        }

        table {
            page-break-inside: avoid;
        }
    }
</style>

@if (_isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Зареждане...</span>
        </div>
    </div>
}
else if (_order is null)
{
    <div class="receipt-page">
        <div class="no-print">
            <a href="/admin/orders" class="btn btn-outline">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Към поръчките
            </a>
        </div>
        <div class="receipt-state" role="@(_notFound ? null : "alert")">
            @if (_notFound)
            {
                <h1>Поръчката не е намерена</h1>
                <p>Няма поръчка с този номер, затова няма и разписка.</p>
            }
            else
            {
                <h1>Разписката не е заредена</h1>
                <p>Не успяхме да заредим поръчката. Опреснете страницата, за да опитате отново.</p>
            }
        </div>
    </div>
}
else if (_order.Status == 0 || _order.IsCancelled)
{
    <div class="receipt-page">
        <div class="no-print">
            <a href="/admin/orders/@Id" class="btn btn-outline">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Към поръчката
            </a>
        </div>
        <div class="receipt-state">
            @if (_order.IsCancelled)
            {
                <h1>Няма разписка</h1>
                <p>Поръчката е отказана, затова за нея не се издава разписка.</p>
            }
            else
            {
                <h1>Още няма разписка</h1>
                <p>Разписка се издава за потвърдени и завършени поръчки. Потвърдете поръчката и опитайте отново.</p>
            }
        </div>
    </div>
}
else
{
    <div class="receipt-page">
        @* Screen-only buttons *@
        <div class="no-print">
            <button type="button" class="btn btn-primary" @onclick="PrintReceipt">
                <i class="bi bi-printer" aria-hidden="true"></i> Принтирай
            </button>
            <a href="/admin/orders/@Id" class="btn btn-outline">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Към поръчката
            </a>
        </div>

        @* Header *@
        <p class="shop-name">Natural Stone Impex</p>
        <p class="shop-line">[Placeholder address]</p>
        <p class="shop-line">[Placeholder phone]</p>
        <hr class="receipt-rule" />

        @* Document title *@
        <h1 class="doc-title">Стокова разписка</h1>
        <p class="doc-line">№ @_order.OrderNumber</p>
        <p class="doc-line">Дата: @GetReceiptDate()</p>

        @* Customer *@
        <div class="customer">
            @if (_order.CustomerType == 0)
            {
                <p><span class="customer-label">Клиент:</span> @_order.CustomerInfo.FullName</p>
                <p><span class="customer-label">Телефон:</span> @_order.CustomerInfo.Phone</p>
            }
            else
            {
                <p><span class="customer-label">Фирма:</span> @_order.CustomerInfo.CompanyName</p>
                <p><span class="customer-label">ЕИК:</span> @_order.CustomerInfo.Eik</p>
                <p><span class="customer-label">МОЛ:</span> @_order.CustomerInfo.Mol</p>
                <p><span class="customer-label">Лице за контакт:</span> @_order.CustomerInfo.ContactPerson</p>
                <p><span class="customer-label">Телефон:</span> @_order.CustomerInfo.ContactPhone</p>
            }
            @if (_order.DeliveryMethod == 1 && !string.IsNullOrWhiteSpace(_order.CustomerInfo.Address))
            {
                <p><span class="customer-label">Адрес:</span> @_order.CustomerInfo.Address</p>
            }
            <p><span class="customer-label">Получаване:</span> @_order.DeliveryMethodDisplay</p>
        </div>

        @* Items *@
        <table class="items-table">
            <thead>
                <tr>
                    <th scope="col">№</th>
                    <th scope="col">Продукт</th>
                    <th scope="col">Количество</th>
                    <th scope="col">Ед. цена без ДДС</th>
                    <th scope="col">ДДС</th>
                    <th scope="col">Ед. цена с ДДС</th>
                    <th scope="col">Общо с ДДС</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _order.Items.Count; i++)
                {
                    var item = _order.Items[i];
                    <tr>
                        <td class="num-col">@(i + 1)</td>
                        <td>@item.ProductName</td>
                        <td class="num-col">@PriceFormat.Quantity(item.Quantity, item.UnitDisplay)</td>
                        <td class="num-col">@PriceFormat.Money(item.UnitPriceWithoutVat)</td>
                        <td class="num-col">@PriceFormat.Money(item.VatAmount)</td>
                        <td class="num-col">@PriceFormat.Money(item.UnitPriceWithVat)</td>
                        <td class="num-col">@PriceFormat.Money(item.RowTotalWithVat)</td>
                    </tr>
                }
            </tbody>
        </table>

        @* Totals *@
        <div class="totals-section">
            <p>Сума без ДДС: @PriceFormat.Money(_order.SubtotalWithoutVat)</p>
            <p>Общо ДДС: @PriceFormat.Money(_order.TotalVat)</p>
            @if (_order.DeliveryFee.HasValue && _order.DeliveryFee.Value > 0)
            {
                <p>Цена за доставка: @PriceFormat.Money(_order.DeliveryFee.Value)</p>
            }
            <hr class="receipt-rule" />
            <p class="grand-total">Обща сума: @PriceFormat.Money(_order.GrandTotal)</p>
        </div>

        @* Signature lines *@
        <div class="signatures">
            <span>Предал: ___________________</span>
            <span>Приел: ___________________</span>
        </div>

        <p class="receipt-footer">Стокова разписка. Не е официален данъчен документ.</p>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private OrderDetailDto? _order;
    private bool _isLoading = true;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _order = await OrderService.GetByIdAsync(Id);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _notFound = true;
        }
        catch
        {
            _order = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetReceiptDate()
    {
        if (_order is null) return string.Empty;

        var date = _order.ConfirmedAt ?? _order.CreatedAt;
        return date.ToLocalTime().ToString("dd.MM.yyyy");
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("printPage");
    }
}
