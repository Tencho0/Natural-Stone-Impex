@page "/admin/orders/{Id:int}"
@layout AdminLayout
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net
@using NaturalStoneImpex.Client.Formatting
@inject IOrderService OrderService

<PageTitle>@(_order is not null ? $"Поръчка {_order.OrderNumber}" : "Поръчка") · Natural Stone Impex</PageTitle>

<p class="page-back">
    <a href="/admin/orders"><i class="bi bi-arrow-left" aria-hidden="true"></i> Поръчки</a>
</p>

@if (_isLoading)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="skeleton" aria-hidden="true">
        <p class="order-head__skeleton"><span class="skeleton-bar"></span></p>
        <div class="table-scroll">
            <table class="data-table">
                <tbody>
                    @for (var i = 0; i < 3; i++)
                    {
                        <tr class="skeleton-row">
                            <td><span class="skeleton-bar"></span></td>
                            <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                            <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (_notFound)
{
    <h1>Поръчката не е намерена</h1>
    <p class="note">Няма поръчка с този номер. Може да е въведен грешен адрес.</p>
    <a href="/admin/orders" class="btn btn-outline">Към поръчките</a>
}
else if (_order is null)
{
    <h1>Поръчка</h1>
    <div role="alert">
        <p class="note note--error">Не успяхме да заредим поръчката. Опитайте отново.</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadAsync">Опитай отново</button>
    </div>
}
else
{
    <div class="order-head">
        <h1 tabindex="-1" @ref="_heading">Поръчка <span class="nowrap">@_order.OrderNumber</span></h1>
        <span class="@OrderFormat.StatusCss(_order.Status, _order.IsCancelled)">@OrderFormat.StatusText(_order.Status, _order.IsCancelled)</span>
    </div>

    <p class="note note--ok order-flash" role="status">@_flash</p>

    @if (!_order.IsCancelled && _order.Status is 0 or 1 or 2)
    {
        <section class="order-actions" aria-label="Действия">
            @if (ShowDeliveryFeeForm)
            {
                <EditForm Model="_fee" OnValidSubmit="SaveDeliveryFeeAsync" class="fee-form">
                    <DataAnnotationsValidator />
                    <div class="field">
                        <label class="field-label" for="delivery-fee">Цена за доставка, €</label>
                        <div class="fee-form__row">
                            <InputNumber id="delivery-fee" class="field-input fee-form__input" @bind-Value="_fee.Value"
                                         min="0" step="0.01" inputmode="decimal"
                                         ParsingErrorMessage="Въведете сума, например 25.00." />
                            <button type="submit" class="btn btn-outline" aria-disabled="@(_savingFee ? "true" : null)">
                                @if (_savingFee)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                }
                                Запази
                            </button>
                        </div>
                        @if (_feeError is not null)
                        {
                            <p class="field-error" role="alert">@_feeError</p>
                        }
                        else
                        {
                            <ValidationMessage For="() => _fee.Value" />
                        }
                    </div>
                </EditForm>
            }

            @* While one confirm is open it is the only thing in the row, so its question reads on its own. *@
            <div class="order-actions__row">
                @if (_order.Status == 0 && _openAction is null or "confirm")
                {
                    <InlineConfirm Label="Потвърди"
                                   TriggerAriaLabel="Потвърди поръчката"
                                   Question="Потвърди поръчката?"
                                   Open="@(_openAction == "confirm")"
                                   OpenChanged="@(open => OnOpenChanged("confirm", open))"
                                   Prepare="() => OrderConfirmPrompt.BuildAsync(OrderService, Id)"
                                   Action="() => OrderService.ConfirmAsync(Id)"
                                   FailureText="@OrderConfirmPrompt.FailureText"
                                   Done="@(() => AfterActionAsync("Поръчката е потвърдена."))" />
                }
                @if (_order.Status == 0 && _openAction is null or "cancel")
                {
                    <InlineConfirm Label="Откажи поръчката"
                                   TriggerClass="btn-outline"
                                   Question="Откажи поръчката? Това не може да се отмени."
                                   Open="@(_openAction == "cancel")"
                                   OpenChanged="@(open => OnOpenChanged("cancel", open))"
                                   Action="() => OrderService.CancelAsync(Id)"
                                   FailureText="Поръчката не е отказана. Проверете връзката и опитайте отново."
                                   Done="@(() => AfterActionAsync("Поръчката е отказана."))" />
                }
                @if (_order.Status == 1)
                {
                    <InlineConfirm Label="Маркирай като завършена"
                                   Question="Маркирай поръчката като завършена?"
                                   Open="@(_openAction == "complete")"
                                   OpenChanged="@(open => OnOpenChanged("complete", open))"
                                   Action="() => OrderService.CompleteAsync(Id)"
                                   FailureText="Поръчката не е завършена. Проверете връзката и опитайте отново."
                                   Done="@(() => AfterActionAsync("Поръчката е завършена."))" />
                }
                @if (_order.Status is 1 or 2 && _openAction is null)
                {
                    <a href="/admin/orders/@_order.Id/receipt" target="_blank" class="btn btn-outline">
                        <i class="bi bi-printer" aria-hidden="true"></i> Разписка
                    </a>
                }
            </div>
        </section>
    }

    <div class="order-cols">
        <section aria-labelledby="order-h">
            <h2 id="order-h" class="section-h">Поръчка</h2>
            <dl class="meta-list">
                <dt>Получена</dt>
                <dd class="num">@OrderFormat.Timestamp(_order.CreatedAt)</dd>
                @if (_order.ConfirmedAt.HasValue)
                {
                    <dt>Потвърдена</dt>
                    <dd class="num">@OrderFormat.Timestamp(_order.ConfirmedAt.Value)</dd>
                }
                @if (_order.CompletedAt.HasValue)
                {
                    <dt>Завършена</dt>
                    <dd class="num">@OrderFormat.Timestamp(_order.CompletedAt.Value)</dd>
                }
                <dt>Получаване</dt>
                <dd>@_order.DeliveryMethodDisplay</dd>
            </dl>
        </section>

        <section aria-labelledby="customer-h">
            <h2 id="customer-h" class="section-h">Клиент</h2>
            <dl class="meta-list">
                <dt>Тип</dt>
                <dd>@_order.CustomerTypeDisplay</dd>
                @if (_order.CustomerType == 0)
                {
                    <dt>Име</dt>
                    <dd>@_order.CustomerInfo.FullName</dd>
                    <dt>Телефон</dt>
                    <dd class="num"><a href="tel:@_order.CustomerInfo.Phone">@_order.CustomerInfo.Phone</a></dd>
                }
                else
                {
                    <dt>Фирма</dt>
                    <dd>@_order.CustomerInfo.CompanyName</dd>
                    <dt>ЕИК</dt>
                    <dd class="num">@_order.CustomerInfo.Eik</dd>
                    <dt>МОЛ</dt>
                    <dd>@_order.CustomerInfo.Mol</dd>
                    <dt>Лице за контакт</dt>
                    <dd>@_order.CustomerInfo.ContactPerson</dd>
                    <dt>Телефон</dt>
                    <dd class="num"><a href="tel:@_order.CustomerInfo.ContactPhone">@_order.CustomerInfo.ContactPhone</a></dd>
                }
                @if (_order.DeliveryMethod == 1 && !string.IsNullOrWhiteSpace(_order.CustomerInfo.Address))
                {
                    <dt>Адрес</dt>
                    <dd>@_order.CustomerInfo.Address</dd>
                }
            </dl>
        </section>
    </div>

    <section aria-labelledby="items-h">
        <h2 id="items-h" class="section-h">Артикули</h2>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th scope="col">Продукт</th>
                        <th scope="col" class="num">Количество</th>
                        <th scope="col" class="num hide-md">Ед. цена без ДДС</th>
                        <th scope="col" class="num hide-md">ДДС</th>
                        <th scope="col" class="num hide-sm">Ед. цена с ДДС</th>
                        <th scope="col" class="num">Общо с ДДС</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _order.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="num">@PriceFormat.Quantity(item.Quantity, item.UnitDisplay)</td>
                            <td class="num hide-md">@PriceFormat.Money(item.UnitPriceWithoutVat)</td>
                            <td class="num hide-md">@PriceFormat.Money(item.VatAmount)</td>
                            <td class="num hide-sm">@PriceFormat.Money(item.UnitPriceWithVat)</td>
                            <td class="num">@PriceFormat.Money(item.RowTotalWithVat)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <dl class="totals">
            <dt>Сума без ДДС</dt>
            <dd>@PriceFormat.Money(_order.SubtotalWithoutVat)</dd>
            <dt>ДДС</dt>
            <dd>@PriceFormat.Money(_order.TotalVat)</dd>
            <dt>Сума с ДДС</dt>
            <dd>@PriceFormat.Money(_order.SubtotalWithVat)</dd>
            <dt>Доставка</dt>
            @if (_order.DeliveryMethod == 0)
            {
                <dd class="totals__muted">Не се прилага</dd>
            }
            else if (_order.DeliveryFee.HasValue)
            {
                <dd>@PriceFormat.Money(_order.DeliveryFee.Value)</dd>
            }
            else
            {
                <dd class="totals__warn">Не е определена</dd>
            }
            <dt class="totals__grand">Обща сума</dt>
            <dd class="totals__grand">@PriceFormat.Money(_order.GrandTotal)</dd>
        </dl>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private OrderDetailDto? _order;
    private bool _isLoading = true;
    private bool _notFound;
    private string? _openAction;
    private string? _flash;
    private bool _focusHeading;
    private ElementReference _heading;

    private readonly FeeModel _fee = new();
    private bool _savingFee;
    private string? _feeError;

    // As before: a delivery order takes a fee while pending, and once confirmed only if none was set.
    private bool ShowDeliveryFeeForm =>
        _order is { IsCancelled: false, DeliveryMethod: 1 } &&
        (_order.Status == 0 || (_order.Status == 1 && !_order.DeliveryFee.HasValue));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        await FetchAsync();
        _isLoading = false;
    }

    // Reloads without the skeleton, so the flash live region and focus survive an action.
    private async Task FetchAsync()
    {
        _notFound = false;
        try
        {
            _order = await OrderService.GetByIdAsync(Id);
            _fee.Value = _order.DeliveryFee;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            _order = null;
            _notFound = true;
        }
        catch
        {
            _order = null;
        }
    }

    // One open confirm at a time.
    private void OnOpenChanged(string action, bool open)
    {
        if (open)
        {
            _openAction = action;
            _flash = null;
        }
        else if (_openAction == action)
        {
            _openAction = null;
        }
    }

    private async Task AfterActionAsync(string message)
    {
        _openAction = null;
        await FetchAsync();
        _flash = message;
        _focusHeading = true;
    }

    private async Task SaveDeliveryFeeAsync()
    {
        if (_savingFee || _fee.Value is not { } value)
            return;

        _savingFee = true;
        _feeError = null;
        _flash = null;
        try
        {
            _feeError = await OrderService.SetDeliveryFeeAsync(Id, value);
        }
        catch
        {
            _feeError = "Цената не е запазена. Проверете връзката и опитайте отново.";
        }
        _savingFee = false;

        if (_feeError is null)
        {
            await FetchAsync();
            _flash = "Цената за доставка е запазена.";
        }
    }

    // After an action the buttons change under the cursor; focus moves to the heading and the flash is announced.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusHeading)
            return;
        _focusHeading = false;
        if (_order is not null)
            await _heading.FocusAsync();
    }

    private sealed class FeeModel
    {
        [Required(ErrorMessage = "Въведете цена за доставка.")]
        [Range(typeof(decimal), "0", "1000000", ErrorMessage = "Цената трябва да е 0 € или повече.")]
        public decimal? Value { get; set; }
    }
}
