@page "/admin/products/new"
@page "/admin/products/{ProductId:int}/edit"
@layout AdminLayout
@attribute [Authorize]
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject NavigationManager Navigation

<PageTitle>@(_isEditMode ? "Редактиране на продукт" : "Нов продукт") · Natural Stone Impex</PageTitle>

<p class="page-back">
    <a href="/admin/products"><i class="bi bi-arrow-left" aria-hidden="true"></i> Продукти</a>
</p>

<h1>@(_isEditMode ? "Редактиране на продукт" : "Нов продукт")</h1>

@if (_isLoadingData)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="form-grid skeleton" aria-hidden="true">
        @for (var i = 0; i < 4; i++)
        {
            <div class="field">
                <span class="skeleton-bar skeleton-bar--short"></span>
                <span class="skeleton-bar" style="height: var(--target-min); width: 100%;"></span>
            </div>
        }
    </div>
}
else if (_loadError)
{
    <div role="alert">
        <p class="note note--error">Не успяхме да заредим продукта. Опитайте отново.</p>
        <a href="/admin/products" class="btn btn-outline btn-sm">Към продуктите</a>
    </div>
}
else
{
    <EditForm Model="_formModel" OnValidSubmit="HandleSave" class="product-form">
        <DataAnnotationsValidator />

        <div class="form-grid">
            <section class="form-section" aria-labelledby="sec-basic">
                <h2 class="section-h" id="sec-basic">Основна информация</h2>

                <div class="field">
                    <label class="field-label" for="productName">Име на продукта</label>
                    <InputText id="productName" class="field-input" @bind-Value="_formModel.Name" disabled="@_isSaving" />
                    <div class="field-slot"><ValidationMessage For="() => _formModel.Name" /></div>
                </div>

                <div class="field">
                    <label class="field-label" for="productCategory">Категория</label>
                    <InputSelect id="productCategory" class="field-input" @bind-Value="_formModel.CategoryId" disabled="@_isSaving">
                        <option value="0">Изберете категория</option>
                        @foreach (var category in _categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                    <div class="field-slot"><ValidationMessage For="() => _formModel.CategoryId" /></div>
                </div>

                <div class="field">
                    <label class="field-label" for="productDescription">Описание</label>
                    <InputTextArea id="productDescription" class="field-input" rows="4" @bind-Value="_formModel.Description" disabled="@_isSaving" />
                    <div class="field-slot">
                        <p class="field-help">По избор, до 2000 символа.</p>
                        <ValidationMessage For="() => _formModel.Description" />
                    </div>
                </div>
            </section>

            <section class="form-section" aria-labelledby="sec-price">
                <h2 class="section-h" id="sec-price">Цени</h2>

                <div class="form-grid__row">
                    <div class="field">
                        <label class="field-label" for="priceWithoutVat">Цена без ДДС, €</label>
                        <InputNumber id="priceWithoutVat" class="field-input" @bind-Value="_formModel.PriceWithoutVat"
                                     disabled="@_isSaving" @bind-Value:after="RecalculatePriceWithVat" step="0.01" inputmode="decimal" />
                        <div class="field-slot"><ValidationMessage For="() => _formModel.PriceWithoutVat" /></div>
                    </div>
                    <div class="field">
                        <label class="field-label" for="vatAmount">ДДС, €</label>
                        <InputNumber id="vatAmount" class="field-input" @bind-Value="_formModel.VatAmount"
                                     disabled="@_isSaving" @bind-Value:after="RecalculatePriceWithVat" step="0.01" inputmode="decimal" />
                        <div class="field-slot"><ValidationMessage For="() => _formModel.VatAmount" /></div>
                    </div>
                    <div class="field">
                        <label class="field-label" for="priceWithVat">Цена с ДДС, €</label>
                        <InputNumber id="priceWithVat" class="field-input" @bind-Value="_formModel.PriceWithVat"
                                     disabled="@_isSaving" step="0.01" inputmode="decimal" />
                        <div class="field-slot">
                            @if (_priceValidationError is not null)
                            {
                                <p class="field-error" role="alert">@_priceValidationError</p>
                            }
                            else
                            {
                                <p class="field-help">Изчислява се сама, може да се промени.</p>
                            }
                            <ValidationMessage For="() => _formModel.PriceWithVat" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="form-section" aria-labelledby="sec-stock">
                <h2 class="section-h" id="sec-stock">Наличност</h2>

                <div class="form-grid__row">
                    <div class="field">
                        <label class="field-label" for="productUnit">Мерна единица</label>
                        <InputSelect id="productUnit" class="field-input" @bind-Value="_formModel.Unit" disabled="@_isSaving">
                            <option value="0">кг</option>
                            <option value="1">м²</option>
                        </InputSelect>
                        <div class="field-slot"><ValidationMessage For="() => _formModel.Unit" /></div>
                    </div>
                    <div class="field">
                        <label class="field-label" for="stockQuantity">Налично количество</label>
                        <InputNumber id="stockQuantity" class="field-input" @bind-Value="_formModel.StockQuantity"
                                     disabled="@_isSaving" step="0.01" inputmode="decimal" />
                        <div class="field-slot"><ValidationMessage For="() => _formModel.StockQuantity" /></div>
                    </div>
                </div>
            </section>

            <section class="form-section" aria-labelledby="sec-image">
                <h2 class="section-h" id="sec-image">Снимка</h2>

                @if (_imagePreviewUrl is not null)
                {
                    <img src="@_imagePreviewUrl" alt="Преглед на новата снимка" class="preview" />
                }
                else if (_isEditMode && !string.IsNullOrEmpty(_existingImagePath))
                {
                    <img src="@_existingImagePath" alt="Текуща снимка" class="preview" />
                }

                <div class="field">
                    <label class="field-label" for="productImage">Файл със снимка</label>
                    <InputFile id="productImage" OnChange="OnImageSelected" accept=".jpg,.jpeg,.png" disabled="@_isSaving" class="field-input" />
                    <div class="field-slot">
                        @if (_imageError is not null)
                        {
                            <p class="field-error" role="alert">@_imageError</p>
                        }
                        else
                        {
                            <p class="field-help">Формати .jpg и .png, до 5 MB.</p>
                        }
                    </div>
                </div>
            </section>

            <section class="form-section" aria-labelledby="sec-viz">
                <h2 class="section-h" id="sec-viz">Визуализатор</h2>

                <div class="field">
                    <label class="check" for="viz-enabled">
                        <input class="check__input" type="checkbox" id="viz-enabled"
                               @bind="_formModel.IsVisualizerEnabled" disabled="@_isSaving" />
                        Достъпен във визуализатора
                    </label>
                </div>

                <div class="field">
                    <label class="field-label" for="viz-width">Реална ширина на текстурата, м</label>
                    <InputNumber id="viz-width" class="field-input" @bind-Value="_formModel.TextureWidthMeters"
                                 disabled="@_isSaving" step="0.01" min="0.1" max="100" inputmode="decimal" />
                    <div class="field-slot"><ValidationMessage For="() => _formModel.TextureWidthMeters" /></div>
                </div>

                @if (_isEditMode)
                {
                    @if (!string.IsNullOrEmpty(_existingTexturePath))
                    {
                        <img src="@_existingTexturePath" alt="Текуща текстура" class="preview preview--texture" />
                    }

                    <div class="field">
                        <label class="field-label" for="productTexture">Текстура за визуализатора (безшевна)</label>
                        <InputFile id="productTexture" OnChange="OnTextureSelected" accept=".jpg,.jpeg,.png" disabled="@_isSaving" class="field-input" />
                        <div class="field-slot">
                            @if (_textureError is not null)
                            {
                                <p class="field-error" role="alert">@_textureError</p>
                            }
                            else
                            {
                                <p class="field-help">
                                    Снимайте продукта отгоре при равномерна светлина. За безшевна текстура използвайте
                                    например GIMP: Filters → Map → Make Seamless.
                                </p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="field-help">Текстурата се качва след създаване на продукта, при редактиране.</p>
                }
            </section>
        </div>

        <div class="save-bar">
            @if (_errorMessage is not null)
            {
                <p class="save-bar__error" role="alert">@_errorMessage</p>
            }
            <div class="save-bar__actions">
                <button type="submit" class="btn btn-primary" aria-disabled="@(_isSaving ? "true" : null)">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    Запази
                </button>
                <button type="button" class="btn btn-outline" @onclick="NavigateBack" disabled="@_isSaving">Отказ</button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? ProductId { get; set; }

    private bool _isEditMode => ProductId.HasValue;
    private bool _isLoadingData = true;
    private bool _loadError;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _priceValidationError;
    private string? _imageError;
    private string? _existingImagePath;
    private string? _imagePreviewUrl;
    private IBrowserFile? _selectedImage;
    private string? _textureError;
    private string? _existingTexturePath;
    private IBrowserFile? _selectedTexture;

    private List<CategoryDto> _categories = new();
    private readonly ProductFormModel _formModel = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await CategoryService.GetAllAsync();

            if (_isEditMode)
            {
                var product = await ProductService.GetByIdAsync(ProductId!.Value);
                if (product is null)
                {
                    _loadError = true;
                    return;
                }

                _formModel.Name = product.Name;
                _formModel.Description = product.Description;
                _formModel.CategoryId = product.CategoryId;
                _formModel.PriceWithoutVat = product.PriceWithoutVat;
                _formModel.VatAmount = product.VatAmount;
                _formModel.PriceWithVat = product.PriceWithVat;
                _formModel.Unit = product.Unit;
                _formModel.StockQuantity = product.StockQuantity;
                _formModel.IsVisualizerEnabled = product.IsVisualizerEnabled;
                _formModel.TextureWidthMeters = product.TextureWidthMeters;
                _existingImagePath = product.ImagePath;
                _existingTexturePath = product.TextureImagePath;
            }
        }
        catch
        {
            _loadError = true;
        }
        finally
        {
            _isLoadingData = false;
        }
    }

    private void RecalculatePriceWithVat()
    {
        _formModel.PriceWithVat = _formModel.PriceWithoutVat + _formModel.VatAmount;
        _priceValidationError = null;
    }

    private bool ValidatePriceConsistency()
    {
        if (_formModel.PriceWithVat != _formModel.PriceWithoutVat + _formModel.VatAmount)
        {
            _priceValidationError = "Цената с ДДС трябва да е равна на цената без ДДС + ДДС.";
            return false;
        }

        _priceValidationError = null;
        return true;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        _imageError = null;
        _selectedImage = null;
        _imagePreviewUrl = null;

        var file = e.File;
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            _imageError = "Позволени формати: .jpg, .png";
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            _imageError = "Файлът не може да е по-голям от 5 MB.";
            return;
        }

        _selectedImage = file;

        // Generate preview
        var buffer = new byte[file.Size];
        await file.OpenReadStream(5 * 1024 * 1024).ReadAsync(buffer);
        var base64 = Convert.ToBase64String(buffer);
        var contentType = extension == ".png" ? "image/png" : "image/jpeg";
        _imagePreviewUrl = $"data:{contentType};base64,{base64}";
    }

    private void OnTextureSelected(InputFileChangeEventArgs e)
    {
        _textureError = null;
        _selectedTexture = null;

        var file = e.File;
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png" };
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (!allowedExtensions.Contains(extension))
        {
            _textureError = "Позволени формати: .jpg, .png";
            return;
        }

        if (file.Size > 5 * 1024 * 1024)
        {
            _textureError = "Файлът не може да е по-голям от 5 MB.";
            return;
        }

        _selectedTexture = file;
    }

    private async Task HandleSave()
    {
        if (_isSaving)
            return;

        if (!ValidatePriceConsistency())
            return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            int productId;

            if (_isEditMode)
            {
                productId = ProductId!.Value;

                // Upload the texture BEFORE updating the product: the server rejects
                // enabling the visualizer without an existing texture ("първо качете
                // текстура"), so if we saved the toggle first, ticking "enabled" +
                // choosing a texture in the same save would fail and discard the file.
                if (_selectedTexture is not null)
                {
                    using var textureStream = _selectedTexture.OpenReadStream(5 * 1024 * 1024);
                    var textureUploadError = await ProductService.UploadTextureAsync(productId, textureStream, _selectedTexture.Name);
                    if (textureUploadError is not null)
                    {
                        _errorMessage = textureUploadError;
                        return;
                    }

                    _existingTexturePath = await BuildTexturePreviewDataUrlAsync(_selectedTexture);
                }

                var updateRequest = new UpdateProductRequest
                {
                    Name = _formModel.Name,
                    Description = _formModel.Description,
                    CategoryId = _formModel.CategoryId,
                    PriceWithoutVat = _formModel.PriceWithoutVat,
                    VatAmount = _formModel.VatAmount,
                    PriceWithVat = _formModel.PriceWithVat,
                    Unit = _formModel.Unit,
                    StockQuantity = _formModel.StockQuantity,
                    IsVisualizerEnabled = _formModel.IsVisualizerEnabled,
                    TextureWidthMeters = _formModel.TextureWidthMeters
                };

                var error = await ProductService.UpdateAsync(productId, updateRequest);
                if (error is not null)
                {
                    _errorMessage = error;
                    return;
                }
            }
            else
            {
                var createRequest = new CreateProductRequest
                {
                    Name = _formModel.Name,
                    Description = _formModel.Description,
                    CategoryId = _formModel.CategoryId,
                    PriceWithoutVat = _formModel.PriceWithoutVat,
                    VatAmount = _formModel.VatAmount,
                    PriceWithVat = _formModel.PriceWithVat,
                    Unit = _formModel.Unit,
                    StockQuantity = _formModel.StockQuantity,
                    IsVisualizerEnabled = _formModel.IsVisualizerEnabled,
                    TextureWidthMeters = _formModel.TextureWidthMeters
                };

                var (newProductId, error) = await ProductService.CreateAsync(createRequest);
                if (error is not null)
                {
                    _errorMessage = error;
                    return;
                }

                productId = newProductId!.Value;
            }

            // Upload image if selected
            if (_selectedImage is not null)
            {
                using var stream = _selectedImage.OpenReadStream(5 * 1024 * 1024);
                var imageError = await ProductService.UploadImageAsync(productId, stream, _selectedImage.Name);
                if (imageError is not null)
                {
                    _errorMessage = imageError;
                    return;
                }
            }

            Navigation.NavigateTo("/admin/products");
        }
        catch
        {
            _errorMessage = "Възникна грешка при свързване със сървъра.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/admin/products");
    }

    // Builds a local data-URL preview from the just-uploaded texture file so the UI
    // reflects the new texture immediately, without depending on the upload response
    // (UploadTextureAsync only returns an error, not the stored path).
    private static async Task<string> BuildTexturePreviewDataUrlAsync(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        var buffer = new byte[file.Size];
        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        await stream.ReadAsync(buffer);
        var base64 = Convert.ToBase64String(buffer);
        var contentType = extension == ".png" ? "image/png" : "image/jpeg";
        return $"data:{contentType};base64,{base64}";
    }

    private sealed class ProductFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Името на продукта е задължително.")]
        [System.ComponentModel.DataAnnotations.MinLength(2, ErrorMessage = "Името трябва да е поне 2 символа.")]
        [System.ComponentModel.DataAnnotations.MaxLength(200, ErrorMessage = "Името не може да надвишава 200 символа.")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.MaxLength(2000, ErrorMessage = "Описанието не може да надвишава 2000 символа.")]
        public string? Description { get; set; }

        [System.ComponentModel.DataAnnotations.Range(1, int.MaxValue, ErrorMessage = "Категорията е задължителна.")]
        public int CategoryId { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0.01, (double)decimal.MaxValue, ErrorMessage = "Цената без ДДС трябва да е по-голяма от 0.")]
        public decimal PriceWithoutVat { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, (double)decimal.MaxValue, ErrorMessage = "ДДС трябва да е по-голямо или равно на 0.")]
        public decimal VatAmount { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0.01, (double)decimal.MaxValue, ErrorMessage = "Цената с ДДС трябва да е по-голяма от 0.")]
        public decimal PriceWithVat { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, 1, ErrorMessage = "Невалидна мерна единица.")]
        public int Unit { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, (double)decimal.MaxValue, ErrorMessage = "Количеството трябва да е по-голямо или равно на 0.")]
        public decimal StockQuantity { get; set; }

        public bool IsVisualizerEnabled { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0.1, 100, ErrorMessage = "Ширината трябва да е между 0.1 и 100 м.")]
        public decimal TextureWidthMeters { get; set; } = 1.00m;
    }
}
