@page "/admin/products"
@layout AdminLayout
@attribute [Authorize]
@implements IDisposable
@using NaturalStoneImpex.Client.Formatting
@inject IProductService ProductService
@inject ICategoryService CategoryService

<PageTitle>Продукти · Natural Stone Impex</PageTitle>

<div class="page-head">
    <h1 tabindex="-1" @ref="_heading">Продукти</h1>
    <a href="/admin/products/new" class="btn btn-primary">Нов продукт</a>
</div>

@if (!_isLoading && _loadError is null)
{
    <p class="page-summary">@ProductFormat.CountText(_products.TotalCount)</p>
}

@if (_successMessage is not null)
{
    <p class="note note--ok" role="status">@_successMessage</p>
}

@if (_categoriesError is not null)
{
    <p class="note note--error" role="alert">@_categoriesError</p>
}

<div class="filter-bar">
    <div class="field">
        <label class="field-label" for="product-search">Търсене</label>
        <input id="product-search" type="search" class="field-input" placeholder="Име на продукт"
               value="@_searchText" @oninput="OnSearchInput" autocomplete="off" />
    </div>
    <div class="field">
        <label class="field-label" for="product-category-filter">Категория</label>
        <select id="product-category-filter" class="field-input" value="@_selectedCategoryId" @onchange="OnCategoryChanged">
            <option value="">Всички категории</option>
            @foreach (var category in _categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
</div>

@if (_isLoading)
{
    <div class="visually-hidden" role="status">Зареждане...</div>
    <div class="table-scroll" aria-hidden="true">
        <table class="data-table">
            <tbody>
                @for (var i = 0; i < 6; i++)
                {
                    <tr class="skeleton-row skeleton">
                        <td><span class="skeleton-bar"></span></td>
                        <td><span class="skeleton-bar skeleton-bar--short"></span></td>
                        <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                        <td class="num"><span class="skeleton-bar skeleton-bar--short"></span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (_loadError is not null)
{
    <div role="alert">
        <p class="note note--error">@_loadError</p>
        <button type="button" class="btn btn-outline btn-sm" @onclick="LoadProductsAsync">Опитай отново</button>
    </div>
}
else if (_products.Items.Count == 0)
{
    <p class="note">Няма намерени продукти.</p>
}
else
{
    <div class="table-scroll">
        @* .has-actions reserves the confirm's width on desktop, so opening one never moves the columns. *@
        <table class="data-table stack-sm actions-row has-actions">
            <thead>
                <tr>
                    <th scope="col">Продукт</th>
                    <th scope="col" class="hide-sm">Категория</th>
                    <th scope="col" class="num">Цена с ДДС</th>
                    <th scope="col" class="num">Наличност</th>
                    <th scope="col"><span class="visually-hidden">Действия</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in _products.Items)
                {
                    var id = product.Id;
                    var productName = product.Name;
                    <tr @key="id" class="@(product.IsActive ? null : "row-inactive")">
                        <td>
                            <div class="cell-product">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="" class="thumb" loading="lazy" onerror="this.style.visibility='hidden'" />
                                }
                                else
                                {
                                    <span class="thumb" aria-hidden="true"></span>
                                }
                                <div class="cell-product__text">
                                    <a href="/admin/products/@id/edit" @ref="_links[id]">@product.Name</a>
                                    <span class="cell-sub show-sm">@product.CategoryName</span>
                                    @if (!product.IsActive)
                                    {
                                        <span class="cell-sub"><span class="status">Неактивен</span></span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="hide-sm">@product.CategoryName</td>
                        <td class="num">@PriceFormat.Money(product.PriceWithVat)</td>
                        <td class="num stack-sm__main @(product.StockQuantity < 0 ? "dash-negative" : null)">
                            <span class="show-sm">Наличност: </span>@PriceFormat.Signed(product.StockQuantity, product.UnitDisplay)
                        </td>
                        <td class="action-cell">
                            <div class="row-actions">
                                <a href="/admin/products/@id/edit" class="btn btn-outline btn-sm"
                                   aria-label="@($"Редактирай {productName}")">Редактирай</a>
                                @if (product.IsActive)
                                {
                                    <InlineConfirm Label="Деактивирай"
                                                   TriggerAriaLabel="@($"Деактивирай {productName}")"
                                                   TriggerClass="btn-outline btn-sm"
                                                   Question="Деактивирай продукта?"
                                                   Open="_openId == id"
                                                   OpenChanged="open => OnOpenChanged(id, open)"
                                                   Action="() => ProductService.DeleteAsync(id)"
                                                   FailureText="Възникна грешка при свързване със сървъра."
                                                   Done="() => OnDeactivatedAsync(id, productName)" />
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="_products.Page" TotalPages="_products.TotalPages" OnPageChanged="OnPageChanged" />
}

@code {
    private PaginatedResponse<ProductListDto> _products = new();
    private List<CategoryDto> _categories = new();
    private bool _isLoading = true;
    private string? _loadError;
    private string? _categoriesError;
    private string? _successMessage;
    private int? _openId;
    private int? _focusProductId;
    private ElementReference _heading;
    private readonly Dictionary<int, ElementReference> _links = new();

    private int? _selectedCategoryId;
    private string _searchText = string.Empty;
    private int _currentPage = 1;
    private const int PageSize = 20;

    private System.Timers.Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        _debounceTimer = new System.Timers.Timer(300);
        _debounceTimer.AutoReset = false;
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _currentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadProductsAsync();
                StateHasChanged();
            });
        };

        try
        {
            _categories = await CategoryService.GetAllAsync();
        }
        catch
        {
            _categoriesError = "Не успяхме да заредим категориите.";
        }

        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        await FetchAsync();
        _isLoading = false;
    }

    // Reloads in place, without the skeleton, so focus and the success note survive a deactivation.
    // The open confirm stays open (and busy) until the new rows are in.
    private async Task FetchAsync()
    {
        _loadError = null;

        try
        {
            _products = await ProductService.GetAllAsync(_selectedCategoryId, _searchText, _currentPage, PageSize);
            // A row kept by @key keeps its element and its @ref is not captured again, so drop only the rows that left.
            var ids = _products.Items.Select(p => p.Id).ToHashSet();
            foreach (var stale in _links.Keys.Where(k => !ids.Contains(k)).ToList())
                _links.Remove(stale);
        }
        catch
        {
            _loadError = "Не успяхме да заредим продуктите. Опитайте отново.";
        }

        _openId = null;
    }

    private async Task OnCategoryChanged(ChangeEventArgs e)
    {
        _selectedCategoryId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _currentPage = 1;
        await LoadProductsAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        _debounceTimer?.Stop();
        _debounceTimer?.Start();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadProductsAsync();
    }

    // One open confirm at a time: opening a row closes any other.
    private void OnOpenChanged(int id, bool open)
    {
        if (open)
            _openId = id;
        else if (_openId == id)
            _openId = null;
    }

    private async Task OnDeactivatedAsync(int id, string name)
    {
        await FetchAsync();
        _successMessage = $"Продуктът „{name}“ е деактивиран.";
        _focusProductId = id;
        _ = AutoDismissSuccessAsync();
    }

    // The row keeps its place (inactive products stay in the list), so focus goes to its name; if it left the
    // page, to the heading.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusProductId is not { } id)
            return;

        _focusProductId = null;
        if (_links.TryGetValue(id, out var link))
            await link.FocusAsync();
        else
            await _heading.FocusAsync();
    }

    private async Task AutoDismissSuccessAsync()
    {
        await Task.Delay(4000);
        _successMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
