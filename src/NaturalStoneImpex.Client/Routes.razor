<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Routes).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            @* Interactive (WebAssembly) routing only. On static SSR pages blazor.web.js would focus the h1 on the
               first load and skip the skip link; js/storefront/shell.js handles enhanced navigation there. *@
            @if (RendererInfo.IsInteractive)
            {
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            }
        </Found>
        <NotFound>
            <PageTitle>Страницата не е намерена</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="container mt-5">
                    <div class="alert alert-warning">
                        <h4>Страницата не е намерена</h4>
                        <p>Съжаляваме, но търсената от вас страница не съществува.</p>
                        <a href="/" class="btn btn-primary">Към началната страница</a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
