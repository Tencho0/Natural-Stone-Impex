@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation

@* Admin shell: a top bar on --paper over --surface content. Styles: css/nsi/admin.css. *@

<div class="admin-ui admin-shell">
    @* A button, not a "#" link: the WebAssembly router turns a fragment link into a navigation and does not move focus. *@
    <button type="button" class="skip-link" @onclick="SkipToContentAsync">Към съдържанието</button>

    <header class="admin-bar">
        <div class="admin-bar__inner">
            <span class="admin-bar__wordmark">NSI Администрация</span>

            <nav class="admin-bar__nav" aria-label="Администрация">
                <NavLink class="admin-bar__link" href="/admin" Match="NavLinkMatch.All">Табло</NavLink>
                <NavLink class="admin-bar__link" href="/admin/products">Продукти</NavLink>
                <NavLink class="admin-bar__link" href="/admin/categories">Категории</NavLink>
                <NavLink class="admin-bar__link" href="/admin/orders">Поръчки</NavLink>
                <NavLink class="admin-bar__link" href="/admin/invoices">Доставки</NavLink>
            </nav>

            <div class="admin-bar__end">
                @* The WASM router ignores data-enhance-nav; target="_top" makes it skip the link, so the browser does a full load. *@
                <a class="admin-bar__link admin-bar__link--quiet" href="/" target="_top" data-enhance-nav="false">Към сайта</a>
                <button type="button" class="admin-bar__link admin-bar__link--quiet admin-bar__logout" @onclick="HandleLogout">Изход</button>
            </div>
        </div>
    </header>

    <main id="admin-main" class="admin-shell__main" tabindex="-1" @ref="_main" @key="Navigation.Uri">
        @Body
    </main>
</div>

@code {
    private ElementReference _main;

    private Task HandleLogout() => AuthService.LogoutAsync();

    private async Task SkipToContentAsync() => await _main.FocusAsync();
}
